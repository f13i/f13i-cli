# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Obsidian paths (relative to f13i-brain vault)
OBSIDIAN_VAULT_PATH=~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents/f13i-brain
BRAIN_PATH=10-brain
DEALS_PATH=30-deals
CLIENTS_PATH=60-clients
PROJECTS_PATH=70-projects

# Granola (MCP server)
GRANOLA_MCP_URL=https://mcp.granola.ai
GRANOLA_MCP_TOKEN=...

# PricingSaaS (MCP server)
PRICINGSAAS_MCP_URL=https://mcp.pricingsaas.com
PRICINGSAAS_MCP_TOKEN=...

# Email (Gmail via OAuth)
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...

# LinkedIn (personal profile posting — developer.linkedin.com app, "Share on LinkedIn" product)
# Scopes needed: w_member_social (post), openid + profile (resolve your member URN).
# Member tokens expire ~60 days — re-run the OAuth flow and replace this value.
LINKEDIN_ACCESS_TOKEN=...
# Optional: skip the userinfo lookup by pinning your URN, e.g. urn:li:person:AbC123
LINKEDIN_MEMBER_URN=
LINKEDIN_API_VERSION=202405

# Feature flags
DEBUG=false
DRY_RUN=true
