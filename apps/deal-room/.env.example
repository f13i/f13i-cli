# Copy to `.env`. Every value has a sensible default — you can run with no .env.

# Your Obsidian vault root (defaults to the f13i-brain iCloud path)
# OBSIDIAN_VAULT_PATH=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/f13i-brain

# Vault folders scanned for content notes (comma-separated, relative to vault)
# DEAL_ROOM_CONTENT_DIRS=50-content/articles

# Idea backlog file surfaced as read-only cards in the Ideas column
# DEAL_ROOM_IDEAS_BACKLOG=70-projects/deal-room-newsletter/02-ideas.md

# Beehiiv — defaults to a cached snapshot. Add an API key for LIVE reads.
# (Beehiiv dashboard -> Settings -> API). Publication id defaults to The Deal Room.
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=pub_eb750555-d4a3-4f32-b716-60458e723f57

# PORT=5180
